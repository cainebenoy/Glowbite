# --- Supabase (required). Local values come from `pnpm supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Salt for hashing visitor IPs (rate limiting). Any long random string.
IP_HASH_SALT=

# Comma-separated admin allowlist, seeded into the `admins` table by `pnpm db:reset`
ADMIN_EMAILS=glowbite.in@gmail.com

# --- Email notifications via Resend (optional; skipped with a log line when unset)
RESEND_API_KEY=
MAIL_FROM="GlowBite <hello@example.com>"

# Optional Slack/Discord-compatible webhook for new leads
TEAM_WEBHOOK_URL=

# --- Cloudflare Turnstile (spam protection; verification is skipped when the secret is unset outside Vercel production)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Temporary production opt-out while Turnstile keys don't exist yet (remove once they do)
# TURNSTILE_DISABLED=true

# Public site URL (canonical, sitemap, email links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: per-IP lead submissions allowed per 10 minutes (default 5)
# RATE_LIMIT_MAX=5
